--=============================================================
-- ELIGIBILITY  (same field as player)
--=============================================================
local function isEligible(part, groupIndex, playerField)
    if not groupIndex then return false end
    if not selectedGroups[groupIndex] then return false end
    if not playerField then return false end
    return getFieldAt(part.Position) == playerField
end

--=============================================================
-- PRIORITY LIST
--=============================================================
local SORT_ORIGIN_TOLERANCE = 32

local function buildPriorityList(origin, playerField)
    local list = {}
    for part, gi in pairs(activeTokens) do
        if part.Parent
        and not skipTokens[part]
        and isEligible(part, gi, playerField) then
            list[#list + 1] = {
                part = part,
                dist = (part.Position - origin).Magnitude,
            }
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    priorityList   = list
    priorityOrigin = origin
    priorityStale  = false
end

local function insertIntoPriorityList(part, gi, origin, playerField)
    if not origin then return end
    if not isEligible(part, gi, playerField) then return end

    local entry = { part = part, dist = (part.Position - origin).Magnitude }
    local lo, hi = 1, #priorityList + 1
    while lo < hi do
        local mid = math.floor((lo + hi) / 2)
        if priorityList[mid].dist < entry.dist then
            lo = mid + 1
        else
            hi = mid
        end
    end
    table.insert(priorityList, lo, entry)
end

local function prunePriorityList(playerField)
    while #priorityList > 0 do
        local entry = priorityList[1]
        local part = entry.part
        local gi = activeTokens[part]
        if not part.Parent
        or not gi
        or skipTokens[part]
        or not isEligible(part, gi, playerField) then
            table.remove(priorityList, 1)
        else
            break
        end
    end
end

--=============================================================
-- TOKEN TRACKING
--=============================================================
local function snapshotTargets()
    local list = {}
    for _, root in ipairs(scanRoots) do
        if root.Parent then
            for _, inst in ipairs(root:GetDescendants()) do
                if getTokenGroup(inst) then
                    list[#list + 1] = inst
                end
            end
        end
    end
    return list
end

local function trackPart(part)
    if not part or not part:IsA("BasePart") then return end
    if skipTokens[part] or activeTokens[part] then return end

    local gi = getTokenGroup(part)
    if not gi then return end

    activeTokens[part] = gi

    if priorityOrigin then
        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local pf   = hrp and getFieldAt(hrp.Position) or nil
        insertIntoPriorityList(part, gi, priorityOrigin, pf)
    else
        priorityStale = true
    end

    part.AncestryChanged:Connect(function(_, parent)
        if not parent then
            activeTokens[part] = nil
        end
    end)
end

local function considerDescendant(desc)
    trackPart(desc)
    local parent = desc.Parent
    if parent and parent:IsA("BasePart") then
        trackPart(parent)
    end
end

--=============================================================
-- INIT: fields, exclusion snapshot, event hooks
--=============================================================
task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    task.wait(INITIAL_SCAN_DELAY)

    refreshFieldBoxes()

    for _, root in ipairs(scanRoots) do
        root.DescendantAdded:Connect(considerDescendant)
    end

    local initial = snapshotTargets()
    for _, part in ipairs(initial) do
        skipTokens[part] = true
        activeTokens[part] = nil
    end
    exclusionsReady = true
    priorityStale = true

    warn(("[Jelly's Farming Script] Ready for %s. Excluded %d initial token(s); roots: %s")
        :format(LocalPlayer.Name, #initial, table.concat(
            (function()
                local names = {}
                for _, r in ipairs(scanRoots) do names[#names + 1] = r.Name end
                return names
            end)(), ", ")))
end)

--=============================================================
-- PICK NEXT TARGET
--=============================================================
local function pickTarget(origin, playerField)
    local needRebuild = priorityStale
        or not priorityOrigin
        or (origin - priorityOrigin).Magnitude > SORT_ORIGIN_TOLERANCE

    -- Rebuild when player field changed since last build.
    if not needRebuild and state.lastField ~= playerField then
        needRebuild = true
    end

    if needRebuild then
        buildPriorityList(origin, playerField)
        state.lastField = playerField
    end

    prunePriorityList(playerField)

    local entry = priorityList[1]
    return entry and entry.part or nil
end

--=============================================================
-- MAIN LOOP
--=============================================================
task.spawn(function()
    while true do
        if state.running and exclusionsReady and fieldBoxesReady then
            local char = LocalPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                local playerField = getFieldAt(hrp.Position)

                if not playerField then
                    -- Not inside any recognised field; nothing to do.
                    task.wait(POLL_INTERVAL)
                else
                    local target = pickTarget(hrp.Position, playerField)

                    if target and target.Parent then
                        skipTokens[target] = true
                        activeTokens[target] = nil
                        if #priorityList > 0 and priorityList[1].part == target then
                            table.remove(priorityList, 1)
                        end

                        local dist = (target.Position - hrp.Position).Magnitude
                        if dist > 0.5 then
                            local info = TweenInfo.new(
                                state.tweenTime,
                                Enum.EasingStyle.Linear,
                                Enum.EasingDirection.Out
                            )
                            local tween = TweenService:Create(hrp, info, {
                                CFrame = CFrame.new(target.Position)
                            })
                            currentTween = tween
                            tween:Play()
                            tween.Completed:Wait()
                            if currentTween == tween then
                                currentTween = nil
                            end
                        end
                        task.wait(0.05)
                    else
                        task.wait(POLL_INTERVAL)
                    end
                end
            else
                task.wait(0.2)
            end
        else
            task.wait(0.1)
        end
    end
end)
